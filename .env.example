# Phase 2 defaults. Legacy npm run dev uses port 4173.
# PGS_PORT=4180
# PGS_AGENT_PORT=4181
# PGS_TLS_PORT=4443
# PGS_STORAGE_DIR=.local/phase2/agent
# PGS_PGLITE_DIR=.local/phase2/catalog
# PGS_PDFJS_DIR=C:/path/to/local/node_modules/pdfjs-dist
# PGS_UI_MODULES=C:/path/to/local/node_modules
# PGS_DB_MODULES=C:/path/to/local/node_modules
# PGS_RUNTIME_MODULES=C:/path/to/local/node_modules
# PGS_MAX_PDF_MB=10
# PGS_HEARTBEAT_MS=15000
# PGS_OFFLINE_MS=45000
# PGS_FIRST_MS=10000
# PGS_TOTAL_MS=30000
# PGS_CONCURRENT=10
# PGS_DATABASE_URL is optional. Use a disposable loopback PostgreSQL database.
# The launcher creates local secrets and test TLS files under the ignored .local directory.
# Phase 3 optional settings. Loopback HTTPS is the default.
# PGS_WEB_TLS=1
# PGS_AUTH_GLOBAL_PER_MINUTE=300
# PGS_AUTH_IP_PER_MINUTE=60
# PGS_AUTH_TOKEN_PER_MINUTE=15
# PGS_BIRTH_KEY_VERSION=2
# PGS_BIRTH_KEYS must be supplied through a protected environment to retain older verifier keys.

# Phase 4 Delphi intake uses Agent Storage/Incoming and the separate PGS_HIS_SECRET.

# Delphi REST settings. Optional internal HTTPS stays off unless a bind IP is set.
# PGS_INTAKE_DIR=C:/approved/PGS-Incoming
# PGS_INTERNAL_API_KEY is supplied through a protected local environment.
# PGS_INTERNAL_TLS_HOST=127.0.0.1
# PGS_INTERNAL_TLS_PORT=4246
# PGS_INTERNAL_TLS_ALLOWLIST=127.0.0.1
# PGS_INTERNAL_TLS_CERT=C:/approved/server.pem
# PGS_INTERNAL_TLS_KEY=C:/approved/server-key.pem
# PGS_INTERNAL_TLS_CLIENT_CA=C:/approved/client-ca.pem

# Phase 5-B local profile
# npm run dev:phase5b
# PGS_PUBLIC_ORIGIN=https://patient.example.invalid
# PGS_RELAY_ORIGIN=https://relay.example.invalid
# PGS_AGENT_ID=<stable-agent-uuid>
# PGS_MANAGER_SESSION_SECONDS=1800
# PGS_MANAGER_BOOTSTRAP supplied only to the Web Manager process.
