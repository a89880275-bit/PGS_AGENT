{
  "name": "pgs-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/build-ui.mjs && node --env-file-if-exists=.env apps/api-server/mock/server.mjs",
    "build": "node scripts/build.mjs && node --env-file-if-exists=.env scripts/build-ui.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser.mjs",
    "dev:phase2": "node --env-file-if-exists=.env scripts/phase2.mjs",
    "dev:phase3": "node --env-file-if-exists=.env scripts/phase2.mjs --phase3",
    "dev:phase4": "node --env-file-if-exists=.env scripts/phase2.mjs --phase4",
    "dev:phase5b": "node --env-file-if-exists=.env scripts/phase2.mjs --phase5b"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.9.5",
    "pdfjs-dist": "5.6.205",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "faye-websocket": "0.11.4",
    "pdf-lib": "1.17.1",
    "@electric-sql/pglite": "0.3.16",
    "pg": "8.16.3"
  }
}
